{
    "name": "real-time-collaborative-whiteboard",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node scripts/dev.ts",
        "build": "vite build",
        "start": "node server/index.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:e2e": "pnpm run build && vitest run --config vitest.e2e.config.ts",
        "bench": "pnpm run build && node bench/bench.ts",
        "screenshots": "pnpm run build && node e2e/screenshots.ts"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.5",
        "hono": "^4.13.13",
        "perfect-freehand": "^1.2.3",
        "ws": "^8.22.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/ws": "^8.18.2",
        "axe-core": "^4.14.0",
        "fast-check": "^4.10.2",
        "jsdom": "^30.1.2",
        "puppeteer-core": "^25.14.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.4"
    },
    "packageManager": "pnpm@11.5.0"
}
