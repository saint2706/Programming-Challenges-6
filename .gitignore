# Rendered Manim output (large binaries, always regenerable from the .py source)
media/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node/JS
node_modules/
dist/

# Runtime data files created by challenge scripts (e.g. the paste bin's SQLite DB,
# the encrypted diary's journal file, the LAN file server's access log)
*.db
*.sqlite
*.sqlite3
*.enc
access.log.jsonl

# OS
.DS_Store
Thumbs.db

# Download caches for challenges that fetch public data (e.g. Geo-Spatial Sales Heatmap Builder)
.cache/

# Rust build output
target/

# Per-challenge first-run caches / runtime output (scoped so committed data dirs elsewhere stay visible)
# Telco Customer Churn + Ames Housing caches, fetched from OpenML on first run
challenges/Practical ML/Churn Prediction Dashboard for a Toy SaaS Dataset/data/
challenges/Practical ML/House Price Predictor with Feature Importance Explainer/data/
# RSVP guest data and model-server request logs
challenges/Web Development Showcase/Single-Page Event Invitation with RSVP/data/
challenges/Practical ML/Model Serving API with Health Checks & Logging/logs/
# Photo album: raw source images
challenges/Web Development Showcase/Drag-to-Reorder Photo Album with Masonry Layout/raw

# Web Traffic Funnel Analyzer: raw REES46 slice downloaded by fetch_data.py
challenges/Data Analytics/Web Traffic Funnel Analyzer/data_cache/
# Data Quality Monitor: batches, corrupted batches, baseline and reports generated by make_sample.py / the CLI
challenges/Data Analytics/Automated Data Quality Monitor/sample_data/batches/
challenges/Data Analytics/Automated Data Quality Monitor/out/

# Statistical Anomaly Detector for Time Series: generated HTML/CSV reports and benchmark output
challenges/Data Analytics/Statistical Anomaly Detector for Time Series/out/

# Generated maps from Geo-Spatial Sales Heatmap Builder (README examples write here)
challenges/Data Analytics/Geo-Spatial Sales Heatmap Builder/*.html
