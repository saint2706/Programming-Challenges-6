{
    "lineWidth": 100,
    "indentWidth": 4,
    "useTabs": false,
    "newLineKind": "lf",
    "markdown": {
        "emphasisKind": "asterisks",
        "strongKind": "asterisks",
        "codeBlock.skipFormat": true
    },
    "json": {},
    "includes": ["**/*.{md,json}"],
    "excludes": [
        "**/media/**",
        "**/__pycache__/**",
        "**/.pytest_cache/**",
        "**/*.pyc",
        "**/node_modules/**",
        ".remember/**"
    ],
    "plugins": [
        "npm:@dprint/markdown@0.26.0",
        "npm:@dprint/json@0.25.2"
    ]
}
